# Copie pra .env e preencha com os dados do seu homelab. O .env só é lido
# pelo main.go local (stand-in) — na plataforma de verdade essas vars vêm do
# ambiente do container.

# --- Kafka ---
KAFKA_BROKERS=192.168.0.X:9092
OUTPUT_TOPIC=pg.homelab.teste
# STATE_TOPIC precisa existir com cleanup.policy=compact (veja README/comandos abaixo).
# Se não setar, vira automaticamente "{OUTPUT_TOPIC}-state".
STATE_TOPIC=pg.homelab.teste-state

# --- Postgres ---
# host/porta/banco/sslmode ficam plain; usuário/senha na InthHub vêm de um
# Secret (mesmo padrão dos outros nodes Go Function da empresa). Aqui no
# .env local não tem diferença entre os dois, é tudo texto mesmo.
# Se o Postgres estiver num container Docker numa VM, aponte PG_HOST pro IP
# da VM (não localhost) e PG_PORT pra porta publicada do container.
PG_HOST=192.168.0.Y
PG_PORT=5432
PG_DATABASE=meubanco
PG_SSLMODE=disable
PG_USER=replicator
PG_PASSWORD=senha

# Lista schema.tabela separada por vírgula. Pode misturar tabela normal,
# particionada e view/materialized view na mesma lista.
SOURCE_TABLES=public.pedidos,public.clientes

# Único por deploy/teste — se rodar duas vezes com o mesmo nome sem apagar o
# slot antigo, retoma de onde parou em vez de recriar.
SLOT_NAME=pgsource_teste_local
PUBLICATION_NAME=pgsource_teste_local

# --- Servidor HTTP local (/healthz, /metrics) ---
# Só usado pelo main.go stand-in local. Troque se 9999 já estiver ocupada
# na sua máquina (erro "bind: only one usage of each socket address...").
HTTP_PORT=9999

# --- Tuning (opcional, pode deixar comentado pra usar os defaults) ---
# SNAPSHOT_FETCH_SIZE=5000
# STATUS_UPDATE_INTERVAL_SECONDS=10
# SLOT_MONITOR_INTERVAL_SECONDS=30
# SLOT_LAG_WARN_BYTES=536870912
# VIEW_REFRESH_INTERVAL_SECONDS=0

# --- Tuning de throughput do snapshot inicial (produção com tabela grande) ---
# Quantas partições-filha são lidas em paralelo (cada uma na sua própria
# conexão). Só importa pra tabela particionada — tabela normal/view sempre lê
# sequencial, uma unidade de cada vez. Veja README "Tuning de produção".
# SNAPSHOT_WORKERS=6

# Tamanho do pool de conexões do Postgres. Precisa comportar SNAPSHOT_WORKERS
# simultâneas + monitor de slot + refresh de views. Default = SNAPSHOT_WORKERS+6.
# PG_POOL_MAX_CONNS=12

# Tamanho de lote do producer Kafka (linhas por lote / bytes por lote).
# KAFKA_BATCH_SIZE=1000
# KAFKA_BATCH_BYTES=5242880
